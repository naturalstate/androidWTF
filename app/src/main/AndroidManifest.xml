<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Drives Termux. Requires allow-external-apps=true in
         ~/.termux/termux.properties as well; the app checks and explains. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- targetSdk >= 30 hides other packages unless declared, and the app needs
         to know whether Termux is installed at all. -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="dev.imranr.obtainium" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidWTF">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AndroidWTF">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
