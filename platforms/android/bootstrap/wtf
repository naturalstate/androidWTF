#!/usr/bin/env bash
#
# androidWTF command entry point.
#
# Thin front door over the engine, mirroring windowsWTF's wtf.cmd -> wtf.ps1 so
# the same verbs work on both platforms. This file contains NO tool logic: it
# resolves the repo root, makes sure Python is present, and dispatches.
#
#   wtf doctor
#   wtf list      --profile android-stock
#   wtf install   --profile android-stock [--dry-run]
#   wtf catalogue [--bundle network]
#
# Nothing is installed until an explicit `install`, and `install` refuses to run
# steps above the device's own tier.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BOLD=$'\033[1m'; YELLOW=$'\033[33m'; RESET=$'\033[0m'
warn() { printf '%s%s%s\n' "$YELLOW" "$*" "$RESET"; }

# doctor is pure bash so it works before anything is installed.
case "${1:-help}" in
	doctor)
		# Explicit bash: the repo copy carries a portable /usr/bin/env shebang,
		# which does not exist on Android.
		exec bash "$HERE/preflight.sh"
		;;
esac

if ! command -v python3 >/dev/null 2>&1; then
	# Check the package repo BEFORE offering to install anything. Offering an
	# install that cannot succeed, then dumping apt's signature errors on the
	# user, makes a Termux problem look like an androidWTF problem. This was
	# the actual first-run experience on an old phone.
	REPO="$(bash -c 'source "'"$HERE"'/preflight.sh"; probe; echo "$WTF_REPO"' 2>/dev/null | tail -1)"
	if [ "$REPO" = stale ]; then
		warn "Python is needed for everything except 'wtf doctor' — but Termux's"
		warn "package repository is not working, so installing it would fail."
		printf '\n'
		printf 'Fix Termux first:\n'
		printf '    termux-change-repo        pick a working mirror\n'
		printf '    pkg update                confirm it works\n'
		printf '\n'
		printf "If that fails, the Termux app is too old to repair from inside.\n"
		printf "Reinstall it from F-Droid or GitHub Releases, then re-run the\n"
		printf "bootstrap. The Play Store build cannot be fixed at all.\n\n"
		printf "Meanwhile 'wtf doctor' works and needs nothing.\n"
		exit 1
	fi
	warn "Python is required for everything except 'wtf doctor'."
	printf 'Install it now with pkg? [y/N] '
	read -r reply
	case "$reply" in
		[yY]*) pkg install -y python || {
			warn "That failed. Run 'wtf doctor' — it reports why."; exit 1; }
			;;
		*) warn "Install it and re-run: pkg install -y python"; exit 1 ;;
	esac
fi

exec python3 "$HERE/wtf.py" "$@"
